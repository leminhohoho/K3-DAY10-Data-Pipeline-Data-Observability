LLM_PROVIDER=gemini
# gemini-2.5-flash da bi Google go quyen truy cap voi tai khoan moi (404 NOT_FOUND).
# `gemini-flash-latest` chay duoc nhung free tier chi 20 request/ngay, khong du cho
# ca hai flow (~60 LLM call). Dung ban flash-lite de co quota cao hon.
LLM_MODEL=gemini-flash-lite-latest
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
